Names Default To Here( 1 );

// Open this saved script in JMP and press Ctrl+R to launch the model window.
// JMP's default directory may differ from the folder containing this script.
launcherName = "00_RUN_CHROMATOGRAPHY_MODEL_IN_JMP.jsl";
setupName = "open_tdm_setup.py";
scriptFile = Try( Char( Get Script Name() ), "" );
projectDir = "";
If( Length( scriptFile ) > Length( launcherName ) &
    Right( Lowercase( scriptFile ), Length( launcherName ) ) == Lowercase( launcherName ),
    scriptFile = Convert File Path( scriptFile, "Absolute", "POSIX" );
    projectDir = Left( scriptFile, Length( scriptFile ) - Length( launcherName ) );
);

// Some JMP launch methods do not expose the script path. Select this copy's
// setup file explicitly rather than guessing from JMP's working directory.
If( projectDir == "" | !File Exists( projectDir || setupName ),
    selectedSetup = Pick File(
        "Select open_tdm_setup.py in the extracted model folder", "",
        {"Python setup|py", "All files|*"}, 1, 0, ""
    );
    If( Is Empty( selectedSetup ),
        Write( "\!nModel launch cancelled: no setup file selected.\!n" );
        Stop();
    );
    selectedSetup = Convert File Path( selectedSetup, "Absolute", "POSIX" );
    If( Right( Lowercase( selectedSetup ), Length( setupName ) ) != setupName,
        Write( "\!nERROR: Select open_tdm_setup.py from the extracted model folder.\!n" );
        Stop();
    );
    projectDir = Left( selectedSetup, Length( selectedSetup ) - Length( setupName ) );
);
If( Right( projectDir, 1 ) != "/", projectDir = projectDir || "/" );

If( !File Exists( projectDir || "open_tdm_setup.py" ) |
    !File Exists( projectDir || "tdm_jmp.py" ) |
    !File Exists( projectDir || "tdm_bridge.py" ) |
    !File Exists( projectDir || "tdm_minimal_io.py" ) |
    !File Exists( projectDir || "tdm_minimal_model.py" ) |
    !File Exists( projectDir || "tdm_least_squares.py" ),
    Write( "\!nERROR: Required model files are missing from " || projectDir || ". Extract the complete ZIP and select open_tdm_setup.py in that folder.\!n" );
    Stop();
);

Set Default Directory( projectDir );

// R23 requires openpyxl for experimental Excel chromatogram ingestion. Use a
// new dependency marker so users upgrading from R22 also get the Excel reader.
dependencyMarker = "$USER_APPDATA/tdm22_classic_direct_dependencies_r23_checked.txt";
If( !File Exists( dependencyMarker ),
    Python Install Packages( "numpy scipy openpyxl" );
    Save Text File( dependencyMarker, "checked" );
);

// Joblib starts separate Python processes for independent run simulations.
parallelMarker = "$USER_APPDATA/tdm22_classic_direct_dependencies_r24p_checked.txt";
If( !File Exists( parallelMarker ),
    Python Install Packages( "joblib" );
    Save Text File( parallelMarker, "checked" );
);

// Allow the normal predictor to cap native numerical-library CPU threads.
nativeThreadMarker = "$USER_APPDATA/tdm22_classic_direct_dependencies_r24q_checked.txt";
If( !File Exists( nativeThreadMarker ),
    Python Install Packages( "threadpoolctl" );
    Save Text File( nativeThreadMarker, "checked" );
);

pythonFile = projectDir || "open_tdm_setup.py";
projectDirWindows = Convert File Path( projectDir, "Absolute", "Windows" );
pythonFileWindows = Convert File Path( pythonFile, "Absolute", "Windows" );
Python Send( projectDirWindows, Python Name( "tdm_project_dir" ) );
Python Send( projectDir, Python Name( "tdm_project_dir_posix" ) );
Python Send( pythonFileWindows, Python Name( "tdm_wrapper_file" ) );
returnCode = Python Submit File( pythonFile );
If( returnCode != 0,
    Write( "\!nERROR: The interface did not open. Check View > Log for the Python traceback.\!n" );
);
