Names Default To Here( 1 );

// Open this saved script in JMP and press Ctrl+R to launch the model window.
// JMP's default directory may differ from the folder containing this script.
launcherName = "00_RUN_CHROMATOGRAPHY_MODEL_IN_JMP.jsl";
setupName = "open_tdm_setup.py";
packageMarker = "tdm_r25c_package.marker";

// JMP can report either a full script path, an editor-window path, or only a
// working directory. Accept a folder only when this package marker and the
// launcher are together, so an older release is not selected by name.
FindModelFolder = Function( {candidate}, {candidatePath, candidateDir},
    candidateDir = "";
    candidatePath = Try( Convert File Path( Char( candidate ), "Absolute", "POSIX" ), "" );
    If( candidatePath != "",
        If( Length( candidatePath ) >= Length( launcherName ) &
            Right( Lowercase( candidatePath ), Length( launcherName ) ) == Lowercase( launcherName ),
            candidateDir = Left( candidatePath, Length( candidatePath ) - Length( launcherName ) ),
            candidateDir = candidatePath
        );
        If( Right( candidateDir, 1 ) != "/", candidateDir = candidateDir || "/" );
        If( !File Exists( candidateDir || packageMarker ) |
            !File Exists( candidateDir || launcherName ) |
            !File Exists( candidateDir || setupName ),
            candidateDir = ""
        );
    );
    candidateDir
);

scriptFile = Try( Char( Get Script Name() ), "" );
projectDir = "";
// A bare script name would resolve against JMP's possibly stale default
// directory. Prefer an editor-window path before trusting that relative name.
If( Contains( scriptFile, ":" ) | Left( scriptFile, 1 ) == "/",
    projectDir = FindModelFolder( scriptFile )
);
If( projectDir == "", projectDir = FindModelFolder( Try( Char( Current Window() << Get Path ), "" ) ) );
If( projectDir == "", projectDir = FindModelFolder( Try( Char( Current Window() << Get File Name ), "" ) ) );
If( projectDir == "", projectDir = FindModelFolder( scriptFile ) );
If( projectDir == "", projectDir = FindModelFolder( Try( Char( Get Default Directory() ), "" ) ) );
If( projectDir == "",
    Write( "\!nERROR: JMP could not locate this extracted model folder automatically. Open the saved 00_RUN_CHROMATOGRAPHY_MODEL_IN_JMP.jsl from the complete extracted ZIP and press Ctrl+R.\!n" );
    Stop();
);

If( !File Exists( projectDir || "open_tdm_setup.py" ) |
    !File Exists( projectDir || "tdm_jmp.py" ) |
    !File Exists( projectDir || "tdm_bridge.py" ) |
    !File Exists( projectDir || "tdm_minimal_io.py" ) |
    !File Exists( projectDir || "tdm_minimal_model.py" ) |
    !File Exists( projectDir || "tdm_least_squares.py" ),
    Write( "\!nERROR: Required model files are missing from " || projectDir || ". Extract the complete ZIP and rerun its saved JMP launcher.\!n" );
    Stop();
);

Write( "\!nOpening chromatography model from " || projectDir || "\!n" );
Set Default Directory( projectDir );

// R23 requires openpyxl for experimental Excel chromatogram ingestion. Use a
// new dependency marker so users upgrading from R22 also get the Excel reader.
dependencyMarker = "$USER_APPDATA/tdm22_classic_direct_dependencies_r23_checked.txt";
If( !File Exists( dependencyMarker ),
    Python Install Packages( "numpy scipy openpyxl" );
    Save Text File( dependencyMarker, "checked" );
);

// Allow the normal predictor to cap native numerical-library CPU threads.
nativeThreadMarker = "$USER_APPDATA/tdm22_classic_direct_dependencies_r24q_checked.txt";
If( !File Exists( nativeThreadMarker ),
    Python Install Packages( "threadpoolctl" );
    Save Text File( nativeThreadMarker, "checked" );
);

pythonFile = projectDir || "open_tdm_setup.py";
projectDirWindows = Convert File Path( projectDir, "Absolute", "Windows" );
pythonFileWindows = Convert File Path( pythonFile, "Absolute", "Windows" );
Python Send( projectDirWindows, Python Name( "tdm_project_dir" ) );
Python Send( projectDir, Python Name( "tdm_project_dir_posix" ) );
Python Send( pythonFileWindows, Python Name( "tdm_wrapper_file" ) );
returnCode = Python Submit File( pythonFile );
If( returnCode != 0,
    Write( "\!nERROR: The interface did not open. Check View > Log for the Python traceback.\!n" );
);
